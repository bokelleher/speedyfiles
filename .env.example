# SpeedyFiles configuration
#
# Copy this file to `.env` and adjust. Required keys are marked.
# Most runtime config (mail, storage choice, webhooks, etc.) can be done
# from the web UI under Settings — env vars are the bootstrap layer only.

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Random 32+ byte secret for session cookie signing AND for deriving the
# encryption key for stored secrets. Rotate carefully — rotating invalidates
# all stored SMTP passwords (you'll need to re-enter them in the UI).
#
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Public URL where this instance is reachable. Used in emailed magic links.
PUBLIC_BASE_URL=https://files.example.com

# ── DATABASE ─────────────────────────────────────────────────────────────────
# SQLite is the default. For Postgres, use:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:////data/app.db

# ── STORAGE ──────────────────────────────────────────────────────────────────
# "local" or "s3". Default: local.
STORAGE_BACKEND=local

# Local backend
LOCAL_STORAGE_ROOT=/srv/files

# S3 backend (only used when STORAGE_BACKEND=s3)
# S3_BUCKET=my-speedyfiles-bucket
# S3_REGION=us-east-1
# S3_PREFIX=packages
# Standard AWS creds via env or ~/.aws/credentials are honored.
# For non-AWS S3 (Cloudflare R2, MinIO, etc.):
# AWS_ENDPOINT_URL=https://your-s3-endpoint

# ── MAIL (bootstrap fallback) ────────────────────────────────────────────────
# The Mail settings page in the admin UI overrides these. They're only the
# defaults shown to the first-run wizard.
SMTP_HOST=127.0.0.1
SMTP_PORT=587
MAIL_FROM_ADDRESS=files@example.com
MAIL_FROM_NAME=SpeedyFiles
# Optional: override HELO/EHLO hostname (default: from-address domain)
# MAIL_ENVELOPE_HELO=mail.example.com

# ── SESSIONS ─────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=speedyfiles_session
# Session TTL in seconds. Default: 7 days.
SESSION_MAX_AGE_SECONDS=604800

# ── BRANDING ─────────────────────────────────────────────────────────────────
APP_NAME=SpeedyFiles

# ── DEBUG ────────────────────────────────────────────────────────────────────
# DEBUG=true loosens cookie security flags so you can run on http://localhost
# without HTTPS. NEVER set true in production.
DEBUG=false
